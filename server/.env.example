# ─────────────────────────────────────────────────────────────────────────────
# EduCore Lite API — environment
# Copy to .env and edit. The API refuses to boot when a required value is missing.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB (the database starts EMPTY — the setup wizard creates the first records)
MONGO_URI=mongodb://localhost:27017/educore

# Secrets — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Browser + cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
BODY_LIMIT=1mb

# Public URL of the web app — used to build password-reset links
APP_URL=http://localhost:3000

# Email (optional). When SMTP_HOST is empty, reset links are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduCore Lite <no-reply@example.com>

# Optional Redis for shared rate-limit counters across API replicas
REDIS_URL=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=4
