# EduCore server — copy to .env and adjust
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/educore

# JWT — access 15m, refresh 7d (httpOnly cookie)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies / CORS
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173

# Email (Nodemailer — optional in dev; falls back to console transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@educore.local

# Redis (optional — leave blank to disable)
REDIS_URL=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=4
